<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/headerBackground</item>
        <item name="colorPrimaryDark">@color/headerBackground</item>
        <item name="colorAccent">@color/accent</item>
    </style>
    <style name="BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/navFooterBackground</item>
    </style>
    <style name="TextAppearance.App.NavItem" parent="TextAppearance.AppCompat.Body2">
        <item name="android:fontFamily">@font/tektur_regular</item>
        <item name="fontFamily">@font/tektur_regular</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/headerText</item>
    </style>
    <style name="RatingBar" parent="AppTheme">
        <item name="colorControlActivated">@color/favoritesInactive</item>
        <item name="colorControlNormal">@color/favoritesInactive</item>
    </style>
    <style name="RoundedCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
